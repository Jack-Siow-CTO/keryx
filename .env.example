# Keryx Worker environment — copy to a private file and fill in secrets.
# User install default:  ~/.config/keryx/env   (mode 600)
# System install default: /etc/keryx/env        (mode 600)
#
# Prefer *_FILE for production secrets. Never commit real tokens or API keys.
# Runtime has NO fake model — configure at least one real provider below.

# Required: bearer token for all /v1/* control-plane calls
KERYX_OPERATOR_TOKEN=change-me-generate-a-long-random-token
# KERYX_OPERATOR_TOKEN_FILE=/run/secrets/keryx-operator-token
# KERYX_OPERATOR_PRINCIPAL=operator

# Loopback only (non-loopback binds are rejected)
KERYX_BIND=127.0.0.1:8787

# SQLite + data directory
KERYX_DATA_DIR=./data

# Concurrent Active Runs across Sessions
KERYX_GLOBAL_ACTIVE_CAP=2

# Default model provider when more than one is registered.
# Single registered provider is auto-selected if this is unset.
# Values: openai | grok | openai_codex | openai_web | grok_web
# KERYX_DEFAULT_PROVIDER=openai_codex

# Optional Run budgets
# KERYX_BUDGET_MAX_DURATION_SECS=300
# KERYX_BUDGET_MAX_TOKENS=100000
# KERYX_BUDGET_MAX_TOOL_CALLS=50

# Workspace file tools (colon-separated roots on Unix)
# KERYX_WORKSPACE_ROOTS=/var/lib/keryx/workspace
# KERYX_ALLOWED_TOOLS=read_file,write_file

# --- Official Platform API keys (recommended when available) ---
# OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai-api-key
# Defaults: OPENAI_MODEL=gpt-5.6-sol, OPENAI_REASONING_EFFORT=low
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_REASONING_EFFORT=low
# OPENAI_MODELS=gpt-5.6-sol
# OPENAI_BASE_URL=

# XAI_API_KEY=
# XAI_API_KEY_FILE=/run/secrets/xai-api-key
# Defaults: XAI_MODEL=grok-4.5, XAI_REASONING_EFFORT=medium
# XAI_MODEL=grok-4.5
# XAI_REASONING_EFFORT=medium
# XAI_MODELS=grok-4.5
# XAI_BASE_URL=

# --- ChatGPT subscription via Codex OAuth (openai_codex) ---
# Prefer: codex login && ./scripts/sync-chatgpt-codex-auth.sh
# Defaults: model gpt-5.6-sol, reasoning low
# CHATGPT_WEB_ACCESS_TOKEN_FILE=$HOME/.config/keryx/chatgpt-access-token
# CHATGPT_CODEX_ACCESS_TOKEN_FILE=   # optional alias of the above
# CHATGPT_ACCOUNT_ID_FILE=$HOME/.config/keryx/chatgpt-account-id
# CHATGPT_CODEX_MODEL=gpt-5.6-sol
# CHATGPT_CODEX_MODELS=gpt-5.6-sol
# CHATGPT_CODEX_REASONING_EFFORT=low
# CHATGPT_CODEX_PATH=/backend-api/codex/responses

# --- ChatGPT browser session (openai_web; requires cookie, unofficial) ---
# CHATGPT_WEB_COOKIE_FILE=
# CHATGPT_WEB_MODEL=gpt-5.6-sol
# CHATGPT_WEB_FORCE=1   # only if you want token-only openai_web without cookie

# --- Grok web subscription session (grok_web; unofficial) ---
# Defaults: model grok-4.5, reasoning medium
# GROK_WEB_COOKIE_FILE=
# GROK_WEB_HEADERS_FILE=
# GROK_WEB_MODEL=grok-4.5
# GROK_WEB_REASONING_EFFORT=medium
# GROK_WEB_MODELS=grok-4.5

# Logging
# RUST_LOG=info
